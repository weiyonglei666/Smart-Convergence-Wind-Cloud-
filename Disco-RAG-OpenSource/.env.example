# Replace placeholders before running. Never commit your real .env.
POWER_LLM_API_KEY=REPLACE_WITH_YOUR_KEY
# Do not reuse the platform FastAPI port 8001 for the generation service.
POWER_LLM_BASE_URL=http://127.0.0.1:8002/v1
POWER_LLM_MODEL=Qwen3.8-27B
POWER_LLM_MAX_TOKENS=1024
POWER_LLM_TEMPERATURE=0
POWER_LLM_TIMEOUT=300
POWER_RAG_TOP_K=10
POWER_CORPUS_ROOT=data/corpus
ELECBENCH_ROOT=data/benchmark
POWER_FAISS_INDEX=indexes/power_public_qwen3e8b_faiss
POWER_EMBEDDING_MODEL=models/Qwen3-Embedding-8B
POWER_EMBEDDING_BATCH_SIZE=2
# Offline RST cache built by scripts/build_rst_cache.py; require it for official runs.
POWER_RST_CACHE=indexes/power_public_qwen3e8b_faiss/rst_cache.json
POWER_REQUIRE_RST_CACHE=1
