MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your-db-user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=your-power-database
FORECAST_TABLE_PREFIX=your-provider-prefix
NWP_SSH_HOST=nwp-host
NWP_SSH_PORT=22
NWP_SSH_USER=your-ssh-user
NWP_REMOTE_DIR=/path/to/nwp/48h
NWP_REFRESH_HOURS=2,4,9,14,16,21
TIMEZONE_NAME=Asia/Shanghai
REALTIME_INTERVAL_SECONDS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
POWER_LLM_API_KEY=
# The generation service must not share port 8001 with this FastAPI backend.
POWER_LLM_BASE_URL=http://127.0.0.1:8002/v1
POWER_LLM_MODEL=Qwen3.8-27B
POWER_RAG_TOP_K=10
POWER_LLM_TEMPERATURE=0
POWER_LLM_MAX_TOKENS=1024
# disco = write RST/graph/planning evidence into the report; light = raw chunks only.
RAG_MODE=disco
# Optional persistent RST cache built from backend/data/knowledge.
RST_CACHE=data/knowledge/.rst_cache.json
